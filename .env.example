WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
PORT=8080
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
META_GRAPH_API_VERSION=v25.0
TZ=America/Sao_Paulo
# Fase 2: habilite apenas para destinatários de teste autorizados na Meta.
WHATSAPP_AUTOMATION_ENABLED=false
WHATSAPP_TEST_RECIPIENTS=
# Obrigatório na Fase 3: PostgreSQL privado do Railway.
DATABASE_URL=

# Opcional: mapa completo de unidades para forp_01, forp_02, forp_03; ausente preserva o banco.
# FORP_BRANCH_ROUTES={"cambui":"forp_02","camanducaia":"forp_02","monte_verde":"forp_02","joanopolis":"forp_03","braganca":"forp_01"}

# Perfil comercial simulado no numero de teste: forp_01, forp_02 ou forp_03.
FORP_TEST_PROFILE=forp_02

# Senha exclusiva do painel (24 a 256 caracteres). Vazio desabilita o painel.
ADMIN_PASSWORD=

# Opcional para confirmar a inscricao deste app na WABA pelo diagnostico.
META_APP_ID=

# Fase 8: manter false até a coexistência e os testes reais.
FORP_PRODUCTION_ENABLED=false
# Uma linha de cada vez. MODE=off | pilot | live.
# FORP_01 = Bragança; FORP_02 = MG; FORP_03 = Joanópolis.
# Repetir as 5 variáveis para FORP_02 e FORP_03, quando necessário.
FORP_01_MODE=off
FORP_01_PHONE_ID=
FORP_01_WABA_ID=
FORP_01_ACCESS_TOKEN=
FORP_01_PILOT_RECIPIENTS=
